{# Tarjeta de noticia, compartida por la portada y el listado del blog.

   Una noticia de un medio externo lleva al artículo original, no a una copia
   dentro del sitio: la entrada de aquí es solo el resumen. Sin enlace guardado,
   la tarjeta va a la entrada propia de siempre. #}

{% set fuera = entrada.meta('noticia_enlace') %}
{% set destino = fuera|default(entrada.link) %}
{% set fuente = entrada.meta('noticia_fuente') %}

<article class="flex h-full flex-col overflow-hidden rounded-lg border border-marca-borde bg-white">
    {% if entrada.thumbnail %}
        <a href="{{ destino }}" {% if fuera %}target="_blank" rel="noopener"{% endif %} class="block aspect-video bg-gray-100 overflow-hidden">
            <img src="{{ entrada.thumbnail.src('medium') }}"
                 alt="{{ entrada.thumbnail.alt|default(entrada.title)|sin_entidades }}"
                 loading="lazy"
                 class="w-full h-full object-cover">
        </a>
    {% endif %}

    <div class="flex flex-1 flex-col p-6">
        <p class="il-rotulo text-xs text-marca-vino-hondo">
            {{ fuente ? fuente ~ ' · ' ~ entrada.date : entrada.date }}
        </p>

        <h3 class="mt-3 text-xl font-normal">
            <a href="{{ destino }}" {% if fuera %}target="_blank" rel="noopener"{% endif %} class="hover:text-marca-vino-hondo">{{ entrada.title|sin_entidades }}</a>
        </h3>

        <a href="{{ destino }}" {% if fuera %}target="_blank" rel="noopener"{% endif %} class="mt-auto pt-4 text-sm font-semibold tracking-[0.05em] text-marca-vino hover:text-marca-vino-hondo">
            {{ fuera ? 'Leer en ' ~ (fuente|default('el medio')) : 'Leer más' }} &rarr;
        </a>
    </div>
</article>
