{# Tarjeta de producto de los carruseles de la portada. Misma pieza que el
   listado de la tienda (views/woocommerce/content-product.twig), con el marcado
   que le corresponde a cada sitio: <article> suelto aquí, <li> con
   wc_product_class() allí. #}
<article class="group flex h-full flex-col overflow-hidden rounded-lg border border-marca-borde bg-white transition hover:shadow-lg">
    <a href="{{ elemento.link }}" class="relative block aspect-square overflow-hidden bg-gray-50">
        {% if elemento.thumbnail %}
            <img src="{{ elemento.thumbnail.src('il-producto') }}"
                 alt="{{ elemento.thumbnail.alt|default(elemento.title)|sin_entidades }}"
                 loading="lazy"
                 class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
        {% endif %}

        {% if elemento.product and elemento.product.is_on_sale %}
            <span class="absolute left-3 top-3 rounded-sm bg-marca-vino px-2 py-1 text-xs font-semibold uppercase tracking-[0.1em] text-white">Oferta</span>
        {% endif %}
    </a>

    <div class="flex flex-1 flex-col p-4">
        <h3 class="text-lg leading-snug">
            <a href="{{ elemento.link }}" class="font-serif font-bold hover:text-marca-vino-hondo">{{ elemento.title|sin_entidades }}</a>
        </h3>


        {# Valoración en la tarjeta: solo si el producto tiene reseñas. Sin
           ellas, WooCommerce pinta cinco estrellas vacías y el listado parece
           lleno de productos mal valorados. #}
        {% if elemento.product.get_rating_count %}
            <div class="mt-2 flex items-center gap-2">
                {{ function('wc_get_rating_html', elemento.product.get_average_rating, elemento.product.get_rating_count)|raw }}
                <span class="text-xs text-marca-tenue">({{ elemento.product.get_rating_count }})</span>
            </div>
        {% endif %}

        {# La clase de producto de la integración expone el WC_Product en
           .product; el precio ya viene formateado por WooCommerce. #}
        {% if elemento.product and elemento.product.get_price_html %}
            <div class="il-precio mt-auto pt-3">{{ elemento.product.get_price_html|raw }}</div>
        {% endif %}

        <div class="mt-3">
            {% include 'partes/anadir-producto.twig' with { producto: elemento.product, id: elemento.id } only %}
        </div>
    </div>
</article>
