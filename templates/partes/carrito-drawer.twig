{# Drawer global. Comparte estado con el widget: los dos leen $store.carrito. #}
<div x-data
     x-show="$store.carrito.abierto"
     x-cloak
     class="fixed inset-0 z-[100]"
     role="dialog"
     aria-modal="true"
     aria-label="Carrito">

    <div class="absolute inset-0 bg-black/40" @click="$store.carrito.cerrar()"></div>

    <aside class="absolute right-0 top-0 h-full w-full max-w-md bg-white shadow-xl flex flex-col"
           x-transition:enter="transition ease-out duration-200"
           x-transition:enter-start="translate-x-full"
           x-transition:enter-end="translate-x-0">

        <header class="flex items-center justify-between p-4 border-b">
            <h2 class="text-lg font-bold">Tu carrito</h2>
            <button type="button" @click="$store.carrito.cerrar()" class="p-2 hover:bg-gray-100 rounded" aria-label="Cerrar">✕</button>
        </header>

        <template x-if="$store.carrito.mensaje">
            <p x-text="$store.carrito.mensaje" class="m-4 p-3 rounded bg-amber-50 text-amber-900 text-sm" role="status"></p>
        </template>

        <div class="flex-grow overflow-y-auto p-4">
            {# Cargando: ni lista ni "vacío". #}
            <template x-if="$store.carrito.cargando">
                <p class="text-gray-500">Cargando tu carrito…</p>
            </template>

            <template x-if="$store.carrito.vacio">
                <p class="text-gray-500">Todavía no has añadido nada.</p>
            </template>

            <ul class="space-y-4">
                <template x-for="articulo in $store.carrito.articulos" :key="articulo.clave">
                    <li class="flex gap-3">
                        <template x-if="articulo.imagen">
                            <img :src="articulo.imagen" :alt="articulo.alt" class="w-16 h-16 object-cover rounded bg-gray-100">
                        </template>

                        <div class="flex-grow min-w-0">
                            <a :href="articulo.enlace" class="font-medium hover:text-marca-vino block truncate" x-text="articulo.nombre"></a>
                            <p class="text-sm text-gray-600" x-text="articulo.total"></p>

                            {# Misma píldora que la ficha y que el bloque de carrito; la da .il-contador. #}
                            <div class="flex items-center gap-3 mt-2">
                                <div class="il-contador">
                                    <button type="button"
                                            @click="$store.carrito.cambiarCantidad(articulo.clave, articulo.cantidad - 1)"
                                            :disabled="$store.carrito.ocupado"
                                            aria-label="Quitar una unidad">−</button>

                                    <span x-text="articulo.cantidad" data-valor></span>

                                    <button type="button"
                                            @click="$store.carrito.cambiarCantidad(articulo.clave, articulo.cantidad + 1)"
                                            :disabled="$store.carrito.ocupado || (articulo.maximo && articulo.cantidad >= articulo.maximo)"
                                            aria-label="Añadir una unidad">+</button>
                                </div>

                                <button type="button"
                                        @click="$store.carrito.eliminar(articulo.clave)"
                                        :disabled="$store.carrito.ocupado"
                                        class="il-papelera ml-auto disabled:opacity-40">Eliminar</button>
                            </div>
                        </div>
                    </li>
                </template>
            </ul>
        </div>

        <footer class="border-t p-4" x-show="!$store.carrito.vacio && !$store.carrito.cargando">
            <div class="flex justify-between font-bold mb-3">
                <span>Total</span>
                <span x-text="$store.carrito.total"></span>
            </div>

            <a href="{{ function('wc_get_cart_url') }}" class="block text-center border rounded py-2 mb-2 hover:bg-gray-50">Ver carrito</a>
            <a href="{{ function('wc_get_checkout_url') }}" class="block text-center bg-marca-oro text-marca-obsidiana font-semibold tracking-wider uppercase rounded-sm py-2 hover:bg-marca-oro-hondo">Finalizar compra</a>
        </footer>
    </aside>
</div>
