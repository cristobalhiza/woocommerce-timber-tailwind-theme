{{ function('do_action', 'woocommerce_before_account_navigation') }}

<nav class="woocommerce-MyAccount-navigation" aria-label="Cuenta">
    <ul class="flex flex-col gap-1">
        {% for endpoint, etiqueta in function('wc_get_account_menu_items') %}
            <li class="{{ function('wc_get_account_menu_item_classes', endpoint) }}">
                <a href="{{ function('wc_get_account_endpoint_url', endpoint) }}"
                   class="block px-3 py-2 rounded hover:bg-gray-100">{{ etiqueta }}</a>
            </li>
        {% endfor %}
    </ul>
</nav>

{{ function('do_action', 'woocommerce_after_account_navigation') }}
